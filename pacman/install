#!/usr/bin/env bash
#
# Arch Linux installer using pacman/yay
#

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

DOCKER=""
POSITIONAL_ARGS=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -d|--docker)
      DOCKER=true
      shift
      ;;
    -*|--*)
      echo "Unknown option $1"
      exit 1
      ;;
    *)
      POSITIONAL_ARGS+=("$1")
      shift
      ;;
  esac
done

echo "==> Updating package database..."
sudo pacman -Syy

# Install yay AUR helper if not present
if ! command -v yay &>/dev/null; then
  echo "==> Installing yay AUR helper..."
  sudo pacman -S --noconfirm --needed git base-devel
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "${tmp_dir}"' EXIT
  git clone https://aur.archlinux.org/yay.git "${tmp_dir}"
  cd "${tmp_dir}"
  makepkg -si --noconfirm
  cd -
fi

# Select package list based on environment
if [[ -n "${DOCKER}" ]]; then
  PKGLIST="${SCRIPT_DIR}/pkglist.docker.txt"
else
  PKGLIST="${SCRIPT_DIR}/pkglist.txt"
fi

echo "==> Installing packages from ${PKGLIST}..."
xargs yay -S --needed --noconfirm --removemake --batchinstall < "${PKGLIST}"

# Change default shell to zsh
echo "==> Setting zsh as default shell..."
sudo chsh -s "$(command -v zsh)" "$(whoami)"

# Setup ASDF
echo "==> Configuring ASDF..."
# shellcheck source=/dev/null
source /opt/asdf-vm/asdf.sh
asdf plugin-add ruby https://github.com/asdf-vm/asdf-ruby.git || true
asdf plugin-add nodejs https://github.com/asdf-vm/asdf-nodejs.git || true

echo "==> Installing latest Ruby..."
latest_ruby=$(asdf list-all ruby | grep -E "^[0-9]+\.[0-9]+\.[0-9]+$" | tail -1)

if [[ -n "${latest_ruby}" ]]; then
  asdf install ruby "${latest_ruby}"
  asdf global ruby "${latest_ruby}"
  echo "==> Ruby ${latest_ruby} installed"
fi

echo "==> Installing Neovim plugins..."
nvim +PlugInstall +qall || true

echo "==> Arch Linux installation complete!"

#!/usr/bin/env bash
#
# Main dotfiles installer - detects OS and runs appropriate installer
#

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

echo "=========================================="
echo "  Dotfiles Installer"
echo "=========================================="
echo ""

# Detect OS and run appropriate installer
if [[ "${OSTYPE}" == darwin* ]]; then
  echo "==> Detected macOS"
  "${SCRIPT_DIR}/brew/install"
  # shellcheck source=/dev/null
  [[ -f "${HOME}/.asdf/asdf.sh" ]] && source "${HOME}/.asdf/asdf.sh"

elif command -v apt-get &>/dev/null && [[ -f /etc/lsb-release ]]; then
  echo "==> Detected Ubuntu/Debian"
  "${SCRIPT_DIR}/apt/install"
  # shellcheck source=/dev/null
  [[ -f "${HOME}/.asdf/asdf.sh" ]] && source "${HOME}/.asdf/asdf.sh"

elif command -v pacman &>/dev/null; then
  echo "==> Detected Arch Linux"
  "${SCRIPT_DIR}/pacman/install" "$@"
  # shellcheck source=/dev/null
  [[ -f /opt/asdf-vm/asdf.sh ]] && source /opt/asdf-vm/asdf.sh

else
  echo "Error: Unsupported operating system"
  echo "Supported: macOS, Ubuntu/Debian, Arch Linux"
  exit 1
fi

# Link dotfiles
echo ""
echo "==> Linking dotfiles..."
"${SCRIPT_DIR}/link-dotfiles.rb"

echo ""
echo "=========================================="
echo "  Installation complete!"
echo "=========================================="
echo ""
echo "Next steps:"
echo "  1. Restart your terminal or run: source ~/.zshrc"
echo "  2. Set up your git identity in ~/.gitconfig.local"
echo ""

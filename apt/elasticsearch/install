#!/usr/bin/env bash
#
# Elasticsearch installer for Ubuntu
#

set -euo pipefail

echo "==> Installing Elasticsearch..."

# Add Elasticsearch GPG key (modern approach, not deprecated apt-key)
sudo install -m 0755 -d /etc/apt/keyrings
wget -qO - https://artifacts.elastic.co/GPG-KEY-elasticsearch | \
  sudo gpg --dearmor -o /etc/apt/keyrings/elasticsearch.gpg
sudo chmod a+r /etc/apt/keyrings/elasticsearch.gpg

# Add repository
echo "deb [signed-by=/etc/apt/keyrings/elasticsearch.gpg] https://artifacts.elastic.co/packages/8.x/apt stable main" | \
  sudo tee /etc/apt/sources.list.d/elastic-8.x.list >/dev/null

sudo apt-get update
sudo apt-get install -y elasticsearch

echo "==> Elasticsearch installation complete!"
echo "    Start with: sudo systemctl start elasticsearch"

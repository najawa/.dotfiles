#!/usr/bin/env bash
#
# ASDF version manager installer
#

set -euo pipefail

ASDF_DIR="${HOME}/.asdf"

echo "==> Installing ASDF..."

if [[ ! -d "${ASDF_DIR}" ]]; then
  git clone https://github.com/asdf-vm/asdf.git "${ASDF_DIR}" --branch v0.14.0 || \
    git clone git@github.com:asdf-vm/asdf.git "${ASDF_DIR}" --branch v0.14.0
fi

# shellcheck source=/dev/null
source "${ASDF_DIR}/asdf.sh"

echo "==> Adding ASDF plugins..."
asdf plugin-add ruby https://github.com/asdf-vm/asdf-ruby.git || true
asdf plugin-add nodejs https://github.com/asdf-vm/asdf-nodejs.git || true

echo "==> Installing latest Ruby..."
# Match Ruby versions like 3.2.0, 3.3.0, etc.
latest_ruby=$(asdf list-all ruby | grep -E "^[0-9]+\.[0-9]+\.[0-9]+$" | tail -1)

if [[ -n "${latest_ruby}" ]]; then
  asdf install ruby "${latest_ruby}"
  asdf global ruby "${latest_ruby}"
  echo "==> Ruby ${latest_ruby} installed and set as global"
else
  echo "Warning: Could not determine latest Ruby version"
fi

echo "==> ASDF installation complete!"
